      "icon": "Icons/Shoppinglistapp.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "pconniff1-tech",
      "repo": "Shopping-List-Maker"
    }
